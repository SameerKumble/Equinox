# Réglages locaux du backend (ne jamais committer .env).
BANK_ISSUER=http://localhost:8788
BANK_AUDIENCE=equinox-local
BANK_KID=equinox-1

# Origine locale autorisée à appeler l'API.
BANK_ALLOWED_ORIGINS=http://localhost:5173
BANK_SECURE_COOKIES=0

# Délai avant d'autoriser un NOUVEAU passkey (60 s pour tester; 24 à 72 h en production).
BANK_RECOVERY_DELAY_SECONDS=60
BANK_REAUTH_WINDOW_SECONDS=300

# Inscriptions limitées à ces adresses (jokers *, séparées par des virgules).
BANK_ALLOWED_EMAILS=*
